# QueueEase backend configuration.
# Copy to backend/.env and fill in. backend/.env is git-ignored; never commit it.
# The server checks these at startup (src/config/env.js) and refuses to start,
# listing every problem, if something is missing or invalid.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# MongoDB connection string. The database name is always "queueease".
#   Local:  mongodb://127.0.0.1:27017
#   Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017

# Secret used to sign login tokens. At least 32 characters.
# This placeholder is deliberately too short, so the server won't start until
# you replace it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it signs everyone out (existing tokens stop working).
JWT_SECRET=replace-me

# Browser origins allowed to call the API and open live-update sockets,
# comma-separated, scheme://host[:port] with no path, trailing slash or "*".
#   Expo web in development:  http://localhost:8081
#   Production web app:       https://your-app.example.com
# Native apps send no Origin header and don't need to be listed.
CORS_ORIGINS=http://localhost:8081

# ---------------------------------------------------------------------------
# Optional (defaults shown)
# ---------------------------------------------------------------------------

# Port the API listens on. The mobile app's development default is 5001
# (see mobile/.env.example); change both if you change this.
PORT=5001

# Login and register attempts allowed per IP per window. Login only counts
# failed attempts.
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MIN=15

# Set to 1 when running behind one reverse proxy (Render, Heroku, Nginx), so
# rate limits see the client's IP instead of the proxy's. Leave unset when
# the API is reached directly, or clients could fake their IP.
# TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Not stored here
# ---------------------------------------------------------------------------
# ADMIN_PASSWORD  passed on the command line when creating an admin, so it
#                 isn't saved in a file:
#                   ADMIN_PASSWORD='...' node scripts/create_admin.js --name "Jane" --email jane@example.com
# NODE_ENV        don't set it here. seed_db.js treats NODE_ENV=test as
#                 permission to wipe a non-local database.
